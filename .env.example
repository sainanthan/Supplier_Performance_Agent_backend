# Copy this file to .env and fill in the values. Never commit .env.

# --- Domo AI Services ---
DOMO_SUBDOMAIN=gwcteq-partner
DOMO_TOKEN=your_developer_token
DOMO_MODEL=domo.domo_ai.domogpt-small-v2.1:anthropic
# Set to true to send responseFormat (JSON schema) to Domo for stricter JSON replies
DOMO_JSON_MODE=false

# --- Neon PostgreSQL ---
# Neon console > your project > Connect > copy the connection string (keep ?sslmode=require)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Filled in automatically by: python -m scripts.create_readonly_role
READONLY_DATABASE_URL=

CORS_ORIGINS=http://localhost:5173
